# Copy this file to .env.local and fill in your own Supabase project values.
# Never commit .env.local or any file containing real keys.

# Found in Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The anon key is safe to expose in the frontend ONLY because Row Level
# Security policies (supabase/migrations) restrict what it can read/write.
# The service_role key must NEVER be used in frontend code.
